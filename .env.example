# ========== MongoDB（数据库管理员账号，首次启动自动创建） ==========
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=请改成强密码

# ========== 应用数据库名 ==========
MONGO_DB_NAME=xhs_demo

# ========== 服务端（向服务商购买后填写） ==========
PROXY_SERVER_URL=http://你的服务商地址/execute-task
PROXY_API_KEY=你的专属key

# ========== Web 控制面板登录账号 ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成你的密码

# 会话加密密钥（随机长字符串）
STORAGE_SECRET=change_me_to_random_long_string

# ========== 小红书检测号（必须是发送设备之一） ==========
CHECK_USER_ID=检测号userid

# ========== 对外端口 ==========
WEB_PORT=8080
MCP_PORT=8090

# 可选：主页公告/README 地址（留空则显示默认公告；客户可自建托管）
README_URL=
# 可选：短链生成远程服务地址（留空则短链功能不可用；客户可自建）
COOKIE_REMOTE_URL=